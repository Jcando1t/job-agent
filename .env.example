# 本地运行环境。不要把真实密钥写入 Git。
APP_ENV=local

# 可以使用相对项目根目录的路径，也可以填写绝对路径。
DATABASE_PATH=data/job_agent.db
FILE_STORAGE_DIR=data/files

# 需要使用 AI 简历改进时填写；页面会在用户明确同意后调用。
DEEPSEEK_API_KEY=
# Also accepts DEEP_SEEK_API_KEY when supplied by the local environment.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
# 默认直连模型服务，避免继承失效系统代理；确实需要代理时改为 1。
LLM_USE_ENV_PROXY=0
